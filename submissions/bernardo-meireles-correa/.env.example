# Copie para .env e preencha. Nenhum segredo vai neste arquivo:
# a chave da Anthropic fica no SSM Parameter Store e é lida por deploy/start.sh.

# Domínio público (registro A no Cloudflare apontando para o IP da EC2, proxy desligado)
DOMAIN=suporte.exemplo.com

# LLM em produção
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low
LLM_TIMEOUT=60

# Tetos de uso do site público
LLM_MAX_CALLS_PER_SESSION=8
LLM_MAX_CALLS_PER_DAY=300

# Formulário de revisão humana desligado no site público
ENABLE_REVIEW=0

# Nome do parâmetro SSM com a chave (SecureString)
ANTHROPIC_KEY_PARAMETER=/g4-support/anthropic-api-key
